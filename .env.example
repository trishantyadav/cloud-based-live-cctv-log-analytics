# Local default: no external requests, deterministic answers and metadata retrieval.
STORAGE_BACKEND=sqlite
SQLITE_PATH=cctv_rag.sqlite3
TIME_ZONE=UTC
SUMMARY_WINDOW_MINUTES=60
EMBEDDING_MODE=disabled
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set EMBEDDING_MODE=minilm after installing requirements-embeddings.txt.
# Direct server-side PostgreSQL access; use a least-privilege role and TLS.
DATABASE_URL=
# Informational only for the direct SQL access pattern; these are not used by the adapter.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
